# build artifacts
node_modules/
*.bundle.js

# --- captures / secrets — NEVER commit (live session cookies, PII, order data) ---
*.log
*.jsonl
.token.json
police_report/.token.json
.auth_replay.json
police_report/.auth_replay.json
.session.json
police_report/.session.json
.token_expired
police_report/.token_expired
.token_state.json
police_report/.token_state.json
.token.lock
police_report/.token.lock
.env
.env.*
police_report/.env

# working report instance — real plate/report PII, keep off-repo (template is report.example.json)
report.todo.json
police_report/report.todo.json
# real filed reports: keep locally for archival, never push (negation [^e] keeps report.example.json)
report.[^e]*.json
police_report/report.[^e]*.json

# scratch RE working dir — apk / jadx / frida hooks, regenerate from sources anytime
_research/
_captures/

capture.log
sf_net.jsonl
sf_requests.jsonl
.sfpid
screen*.png
*.apk
*.idsig
*.jks

# --- police_report local assets (large binaries / real data, kept off-repo) ---
# Real dashcam footage of traffic violations (privacy + size); report.<plate>.json
# is the only filed artifact that goes off-repo and is already covered above.
police_report/camera/
# Vendor APK + rootAVD (submodule-style, has its own .git) — pull fresh via
# police_report/scripts/pull_install_apk.sh; only the script is checked in.
police_report/vendor/
# Stray debug screenshots from manual frida runs / extract_overlay testing
mpv-shot*.jpg
police_report/mpv-shot*.jpg

# python
__pycache__/
*.pyc
